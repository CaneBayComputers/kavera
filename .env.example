APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Leave AWS_BUCKET empty in dev (images served from local storage); set it to <site>.cdn in production
# so cdn() serves images from S3. Path style is required: the dot in .cdn bucket names breaks virtual-host TLS.
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# IP lookup via ip-api.com
# Key is not required unless paying for premium plan
# Service is used for ip lookups on form submissions
IP_API_KEY=
IP_API_LANG=en

# Google ReCaptcha
# Visit https://developers.google.com/recaptcha
# REQUIRED for production
# NOT required for testing, bypassed in dev
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Contact form settings
# Dev just sends to Mailhog
CONTACT_FORM_MAIL_TO=
CONTACT_FORM_SUCCESS_PAGE=
CONTACT_FORM_WEBHOOK_URL=

# Eventbrite integration
# Set your Private token (Personal OAuth token) from https://www.eventbrite.com/platform/api-keys
EVENTBRITE_PRIVATE_TOKEN=
EVENTBRITE_ORGANIZATION_ID=
EVENTBRITE_STATUS=live,started
EVENTBRITE_TIME_FILTER=current_future
EVENTBRITE_PAGE_SIZE=10
EVENTBRITE_EXPAND=venue,logo,organizer
EVENTBRITE_CACHE_KEY=eventbrite.events

# Google Blogger (read-only public posts)
BLOGGER_API_KEY=
BLOGGER_BLOG_ID=
BLOGGER_BASE_URL=https://www.googleapis.com/blogger/v3
BLOGGER_TIMEOUT=8
BLOGGER_CACHE_KEY=blogger.posts
BLOGGER_MAX_RESULTS=50
BLOGGER_CONTENT_BASE=blog
BLOGGER_STORAGE_DIR=blogger
BLOGGER_POST_LAYOUT=templates.blog
BLOGGER_POST_SECTION=blog_content
BLOGGER_LABEL_SEGMENT=labels

# Mailchimp
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_STATUS=subscribed
# Optional per-form tags (comma-separated)
# Example for the `contact` form
MAILCHIMP_CONTACT_TAGS=

# Zapier
ZAPIER_CONTACT_WEBHOOK_URL=

# Salesforce
SALESFORCE_BASE_URL=
SALESFORCE_API_VERSION=v59.0
SALESFORCE_OBJECT=Lead
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_DEFAULT_COMPANY=Unknown

# Flickr galleries (php artisan app:flickr-sync). Key from https://www.flickr.com/services/apps/create/
FLICKR_API_KEY=
FLICKR_USER_ID=
FLICKR_AUTO_SYNC=true
